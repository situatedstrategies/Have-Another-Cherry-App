# Local development only. In production these come from Cloud Secret Manager,
# referenced from apphosting.yaml — never commit real values here.

# Resend API key for invite and password-reset email.
RESEND_API_KEY=

# There is deliberately no GEMINI_API_KEY. This Google Cloud org blocks
# standalone Gemini API keys, so the app calls Gemini through Vertex AI with
# Application Default Credentials instead. For local dev run:
#   gcloud auth application-default login
#   gcloud config set project gen-lang-client-0987674990
