rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupExists(groupId) {
      return exists(groupPath(groupId));
    }

    function isGroupMember(groupId) {
      return signedIn()
        && groupExists(groupId)
        && request.auth.uid in get(groupPath(groupId)).data.get('memberIds', []);
    }

    // Member lists read defensively. Reading `resource.data.memberIds` directly
    // does not evaluate to false when the field is absent — it raises an
    // evaluation error, and an errored rule denies. A group document written
    // before these fields existed, or one whose two member lists have drifted
    // apart, therefore locks its own members out with "Missing or insufficient
    // permissions" and no way to recover, including on the invite-code path.
    function currentMemberIds() {
      return resource.data.get('memberIds', []);
    }

    function incomingMemberIds() {
      return request.resource.data.get('memberIds', []);
    }

    function currentMembers() {
      return resource.data.get('members', []);
    }

    function incomingMembers() {
      return request.resource.data.get('members', []);
    }

    function isExistingGroupMember() {
      return signedIn()
        && request.auth.uid in currentMemberIds();
    }

    // Allows a signed-in user to add only themselves through the invite-code
    // join flow, and to repair a half-joined state (listed in `members` but
    // missing from `memberIds`, which locks them out of every other rule since
    // they all key off `memberIds`). Expressed as a set difference rather than
    // size arithmetic so it also holds when the stored lists contain a legacy
    // duplicate: the only id that may appear that wasn't there before is the
    // caller's own, and no existing member may be dropped.
    function isValidSelfJoin() {
      return signedIn()
        && !(request.auth.uid in currentMemberIds())
        && request.auth.uid in incomingMemberIds()
        && incomingMemberIds().toSet().difference(currentMemberIds().toSet())
           == [request.auth.uid].toSet()
        && currentMemberIds().toSet().difference(incomingMemberIds().toSet()).size() == 0
        && incomingMembers().size() >= currentMembers().size()
        && incomingMembers().size() <= currentMembers().size() + 1
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               'members',
               'memberIds',
               'availableSplits',
               'defaultSplit'
             ]);
    }

    match /users/{userId} {
      allow create, read, update, delete:
        if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // Required so a signed-in invite recipient can retrieve the group
      // using the invite code, which is also the document ID.
      allow get: if signedIn();

      // General group listing is restricted to existing members.
      allow list:
        if signedIn()
        && request.auth.uid in currentMemberIds();

      allow create:
        if signedIn()
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;

      allow update:
        if isExistingGroupMember() || isValidSelfJoin();

      allow delete:
        if isExistingGroupMember();

      match /expenses/{expenseId} {
        allow read, create, update, delete:
          if isGroupMember(groupId);
      }
    }

    // Encrypted shared ledger snapshot used to hydrate new devices/members.
    // Only authenticated members of the corresponding group may access it.
    match /group_ledgers/{groupId} {
      allow read, create, update, delete:
        if isGroupMember(groupId);
    }

    match /group_mismatches/{groupId}/events/{eventId} {
      allow read, create, update, delete:
        if isGroupMember(groupId);
    }

    match /transfer_queue/{queueId} {
      allow create:
        if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.groupId is string
        && request.resource.data.action in ['UPSERT', 'DELETE']
        && request.resource.data.payload is string
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.to
             in get(groupPath(request.resource.data.groupId)).data.get('memberIds', []);

      allow read, delete:
        if signedIn()
        && resource.data.to == request.auth.uid;

      allow update: if false;
    }

    // Invite email is sent through the authenticated backend endpoint,
    // not through unrestricted client-side Firestore writes.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
