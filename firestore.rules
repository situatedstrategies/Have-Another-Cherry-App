rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupExists(groupId) {
      return exists(groupPath(groupId));
    }

    function isGroupMember(groupId) {
      return signedIn()
        && groupExists(groupId)
        && request.auth.uid in get(groupPath(groupId)).data.memberIds;
    }

    function isExistingGroupMember() {
      return signedIn()
        && request.auth.uid in resource.data.memberIds;
    }

    // The set of groups the requesting user belongs to (multi-group support).
    // Defaults to an empty list for accounts not yet migrated to `groupIds`.
    function myGroupIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('groupIds', []);
    }

    // Allows a signed-in user to add only themselves through the
    // invite-code join flow. Existing group members may update normal
    // group settings.
    function isValidSelfJoin() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size()
             == resource.data.memberIds.size() + 1
        && request.resource.data.members.size()
             == resource.data.members.size() + 1
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               'members',
               'memberIds',
               'availableSplits',
               'defaultSplit'
             ]);
    }

    match /users/{userId} {
      allow create, update, delete:
        if signedIn() && request.auth.uid == userId;

      // A user can read their own doc, or the doc of someone with whom they share
      // at least one group (the app loads member names, incomes, and profile
      // state for the roster). Supports users who belong to several groups; the
      // legacy single-`groupId` branch keeps un-migrated members readable.
      allow read:
        if signedIn()
        && (
          request.auth.uid == userId
          || resource.data.get('groupIds', []).hasAny(myGroupIds())
          || (
            resource.data.get('groupId', null) != null
            && isGroupMember(resource.data.get('groupId', null))
          )
        );
    }

    match /groups/{groupId} {
      // Required so a signed-in invite recipient can retrieve the group
      // using the invite code, which is also the document ID.
      allow get: if signedIn();

      // General group listing is restricted to existing members.
      allow list:
        if signedIn()
        && request.auth.uid in resource.data.memberIds;

      allow create:
        if signedIn()
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;

      allow update:
        if isExistingGroupMember() || isValidSelfJoin();

      allow delete:
        if isExistingGroupMember();

      match /expenses/{expenseId} {
        allow read, create, update, delete:
          if isGroupMember(groupId);
      }
    }

    // Encrypted shared ledger snapshot used to hydrate new devices/members.
    // Only authenticated members of the corresponding group may access it.
    match /group_ledgers/{groupId} {
      allow read, create, update, delete:
        if isGroupMember(groupId);
    }

    match /group_mismatches/{groupId}/events/{eventId} {
      allow read, create, update, delete:
        if isGroupMember(groupId);
    }

    match /transfer_queue/{queueId} {
      allow create:
        if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.groupId is string
        && request.resource.data.action in ['UPSERT', 'DELETE']
        && request.resource.data.payload is string
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.to
             in get(groupPath(request.resource.data.groupId)).data.memberIds;

      allow read, delete:
        if signedIn()
        && resource.data.to == request.auth.uid;

      allow update: if false;
    }

    // Invite email is sent through the authenticated backend endpoint,
    // not through unrestricted client-side Firestore writes.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Append-only log of AI-generated financial profiles. Standalone (not tied
    // to a user/group doc); used as a growing record and future fixed fallback
    // catalog. Signed-in users may append; the log is curated via the console,
    // so it is not client-readable/editable.
    match /profile_log/{docId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
